from typing import List

class Solution:
    def minOperations(self, nums: List[int], x: int) -> int:
        total_sum = sum(nums)
        
        # Target for middle window
        target = total_sum - x
        
        # Edge case: x equals total sum
        if target == 0:
            return len(nums)
        
        n = len(nums)
        left = 0
        current_sum = 0
        max_len = -1
        
        # Sliding window to find longest subarray with sum = target
        for right in range(n):
            current_sum += nums[right]
            
            # Shrink window when sum exceeds target
            while current_sum > target and left <= right:
                current_sum -= nums[left]
                left += 1
            
            # Check if we found valid window
            if current_sum == target:
                max_len = max(max_len, right - left + 1)
        
        # Return operations count or -1 if no solution exists
        return len(nums) - max_len if max_len != -1 else -1
